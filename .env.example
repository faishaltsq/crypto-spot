APP_ENV=development
MARKET_MODE=gate
HTTP_ADDR=:8080
DATABASE_URL=postgres://signal:signal@postgres:5432/signal?sslmode=disable
MIGRATION_TIMEOUT_SECONDS=60
MIGRATION_RETRIES=30
MIGRATION_RETRY_DELAY_SECONDS=2
REDIS_ADDR=redis:6379
REDIS_PASSWORD=
REDIS_DB=0

GATE_WS_URL=wss://api.gateio.ws/ws/v4/
GATE_REST_URL=https://api.gateio.ws/api/v4
GATE_TIMEFRAMES=10s,1m,5m,15m,30m,1h,4h,8h,1d,7d
GATE_ORDERBOOK_INTERVAL=100ms
GATE_WS_MAX_PAIRS_PER_CONNECTION=50
GATE_WS_RECONNECT_MIN_SECONDS=2
GATE_WS_RECONNECT_MAX_SECONDS=60
GATE_WS_STALE_TIMEOUT_SECONDS=30
GATE_WS_SUBSCRIBE_BATCH_SIZE=20
GATE_WS_SUBSCRIBE_BATCH_DELAY_MS=250

DATA_STALE_TICKER_SECONDS=10
DATA_STALE_ORDERBOOK_SECONDS=5
DATA_STALE_CANDLE_SECONDS=90
DATA_RECONNECT_COOLDOWN_SECONDS=30
DATA_MAX_PRICE_DEVIATION_BPS=100
DATA_MAX_QUEUE_UTILIZATION_PERCENT=85

# Market Data Recorder
MARKET_RECORDER_ENABLED=true
MARKET_RECORDER_BATCH_SIZE=500
MARKET_RECORDER_FLUSH_INTERVAL_MS=1000
MARKET_RECORDER_MAX_BUFFER_ITEMS=50000

# Simulation Configuration
PAPER_SIMULATION_ENABLED=true
PAPER_NOTIONALS=50,100,250,500,1000
PAPER_INCLUDE_ENTRY_FEE=true
PAPER_INCLUDE_EXIT_FEE=true
PAPER_INCLUDE_ENTRY_SLIPPAGE=true
PAPER_INCLUDE_EXIT_SLIPPAGE=true
PAPER_ALLOW_PARTIAL_FILL=true
PAPER_DEFAULT_FEE_BPS=10

MARKET_PAIR_LIMIT=150
MARKET_QUOTE_CURRENCY=USDT
MARKET_TIER_A_LIMIT=30
MARKET_TIER_B_LIMIT=50
MARKET_TIER_C_LIMIT=70

PAIR_UNIVERSE_REFRESH_MINUTES=10
PAIR_MIN_QUOTE_VOLUME_24H=100000
PAIR_MAX_SPREAD_BPS=80
PAIR_NEW_LISTING_MIN_AGE_HOURS=72

SCAN_INTERVAL=5s
ORDERBOOK_DEPTH_PERCENT=0.5
MAX_SPREAD_BPS=35
MIN_DEPTH_QUOTE=25000

SIGNAL_MIN_SCORE=70
SIGNAL_CONFIRM_SCORE=80
SIGNAL_MIN_MODEL_PROBABILITY=0.60
SIGNAL_PAIR_COOLDOWN_MINUTES=30
SIGNAL_MAX_ACTIVE_PER_PAIR=1
SIGNAL_MAX_NOTIFICATIONS_PER_HOUR=20

AI_ENABLED=true
AI_SERVICE_URL=http://ai-service:8090
AI_PROVIDER=deepseek
AI_API_KEY=your_deepseek_api_key_here
AI_MODEL=deepseek-chat
AI_TIMEOUT_SECONDS=15

NEXT_PUBLIC_API_URL=http://localhost:8080
NEXT_PUBLIC_WS_URL=ws://localhost:8080/ws
